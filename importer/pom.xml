<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.wowforever</groupId>
    <artifactId>wow-forever-browser</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>importer</artifactId>
  <name>Data importer</name>

  <properties>
    <!-- import-data profile: the converted client data (tools/clientdata/convert.py output) -->
    <clientdata.dir>${user.home}/.cache/wowforever-clientdata/out/current</clientdata.dir>
    <!-- import-data profile: the client-data argument; -Dclientdata.skip=true replaces it with skip-client-data -->
    <clientdata.args>--client-data-dir "${clientdata.dir}"</clientdata.args>
    <!-- import-data profile: the coverage gate's minimum percentage of named items with client data -->
    <clientdata.coverageMin>85</clientdata.coverageMin>
  </properties>

  <dependencies>
    <dependency>
      <groupId>dev.wowforever</groupId>
      <artifactId>lua-table</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- Runnable fat jar at target/importer.jar. outputFile leaves the module's main artifact (and the
           test-jar the app module uses) untouched instead of replacing it with the shaded jar. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <outputFile>${project.build.directory}/importer.jar</outputFile>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>dev.wowforever.importer.Main</mainClass>
                  <manifestEntries>
                    <Multi-Release>true</Multi-Release>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- mvn -pl importer -am -Pimport-data verify: rebuilds app/src/main/resources/data/wowforever.sqlite with the
         client data in -Dclientdata.dir (default ~/.cache/wowforever-clientdata/out/current), or without client data
         with -Dclientdata.skip=true; -Dclientdata.coverageMin=<pct> sets the coverage gate (default 85). The arguments
         are one commandlineArgs string, so -Dexec.args would replace all of them. -->
    <profile>
      <id>import-data</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>import-data</id>
                <phase>verify</phase>
                <goals>
                  <goal>java</goal>
                </goals>
                <configuration>
                  <mainClass>dev.wowforever.importer.Main</mainClass>
                  <commandlineArgs>--out "${project.basedir}/../app/src/main/resources/data/wowforever.sqlite" --fail-on-unsupported --coverage-min ${clientdata.coverageMin} ${clientdata.args}</commandlineArgs>
                  <systemProperties>
                    <systemProperty>
                      <key>wowforever.importer.noExit</key>
                      <value>true</value>
                    </systemProperty>
                  </systemProperties>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- -Dclientdata.skip=true: the import-data profile imports without client data -->
    <profile>
      <id>import-data-skip-client-data</id>
      <activation>
        <property>
          <name>clientdata.skip</name>
          <value>true</value>
        </property>
      </activation>
      <properties>
        <clientdata.args>--skip-client-data</clientdata.args>
      </properties>
    </profile>
  </profiles>
</project>
